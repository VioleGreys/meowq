#!/usr/bin/env python
# Сборка: положить godot-cpp (master, API 4.7) в native/godot-cpp и выполнить
#   scons platform=linux target=template_release            (ПК)
#   scons platform=android arch=arm64 target=template_release (телефон, нужен ANDROID_HOME/NDK)
# Библиотека появляется в bin/, игра подхватывает её через meowq.gdextension.
# godot-cpp (master) собирается под API движка 4.7
ARGUMENTS.setdefault("api_version", "4.7")
env = SConscript("godot-cpp/SConstruct")
env.Append(CPPPATH=["src/"])
# одинаковые результаты с GDScript: без слияния умножения и сложения (FMA)
env.Append(CCFLAGS=["-ffp-contract=off"])
sources = Glob("src/*.cpp")
lib = "bin/libmeowq{}{}".format(env["suffix"], env["SHLIBSUFFIX"])
Default(env.SharedLibrary(lib, source=sources))

# Манифест расширения кладём в корень проекта только когда библиотека собрана:
# без неё Godot выдавал бы ошибку загрузки, а игра и так работает на GDScript.
def _install_manifest(target, source, env):
    import shutil
    shutil.copy("meowq.gdextension.in", "../meowq.gdextension")
AddPostAction(lib, _install_manifest)
