[configuration]

entry_symbol = "meowq_library_init"
compatibility_minimum = "4.3"

[libraries]

linux.debug.x86_64 = "res://native/bin/libmeowq.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://native/bin/libmeowq.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://native/bin/libmeowq.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://native/bin/libmeowq.windows.template_release.x86_64.dll"
android.debug.arm64 = "res://native/bin/libmeowq.android.template_debug.arm64.so"
android.release.arm64 = "res://native/bin/libmeowq.android.template_release.arm64.so"
