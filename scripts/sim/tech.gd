const BONUS_NAMES := {
	"industry": "выпуск снаряжения", "research": "скорость науки", "construction": "стройка",
	"resources": "добыча ресурсов", "attack": "атака дивизий", "defense": "оборона дивизий",
	"org": "организация", "speed": "скорость войск", "manpower": "призыв", "reinforce": "пополнение",
	"inf_attack": "атака пехоты", "inf_defense": "оборона пехоты",
	"art_attack": "атака артиллерии", "art_defense": "оборона артиллерии",
	"tank_attack": "атака танков", "tank_defense": "оборона танков",
	"air": "вся авиация", "air_fighter": "истребители", "air_cas": "поддержка войск с воздуха",
	"air_bomb": "бомбардировки заводов", "air_naval": "удары авиации по флоту",
	"air_def": "защита от бомбардировок",
	"naval": "все корабли", "ship_bb": "линкоры", "ship_cr": "крейсеры", "ship_dd": "эсминцы",
	"ship_ss": "подлодки", "sub_raid": "рейды подлодок", "escort": "охрана торговли",
	"shipyard": "судостроение",
}

# Базовые стартовые технологии по промышленности (фабрик гражд. + воен.):
# только мирные — военный упор у каждой страны свой (techs в nations.json).
const START_BASE := [[20, ["ind1", "con1", "res1"]], [8, ["ind1", "con1"]]]

# бонусы, которые читаются прямо из страны (без кэша в дивизиях и массивах)
const ECON_KEYS := {"industry": true, "research": true, "construction": true, "resources": true,
	"manpower": true, "reinforce": true, "sub_raid": true, "escort": true, "shipyard": true,
	"synth_oil": true, "synth_rubber": true}

static var _list: Array = []
static var _index := {}
static var _by_cat := {}


static func _ensure() -> void:
	if not _list.is_empty():
		return
	for i in RAW.size():
		var r: Array = RAW[i]
		var t := {"id": r[0], "cat": r[1], "row": r[2], "year": r[3], "req": r[4], "name": r[5],
			"bonus": r[6], "desc": r[7], "n": i, "days": base_days(int(r[3]))}
		_list.append(t)
		_index[r[0]] = t
		if not _by_cat.has(r[1]):
			_by_cat[r[1]] = []
		_by_cat[r[1]].append(t)


## Трудоёмкость по году технологии: поздние дольше.
static func base_days(year: int) -> float:
	return 120.0 + 12.0 * clampi(year - World.START_YEAR, 0, 9)


static func all() -> Array:
	_ensure()
	return _list


static func of_cat(cat: String) -> Array:
	_ensure()
	return _by_cat.get(cat, [])


static func get_tech(id: String) -> Dictionary:
	_ensure()
	return _index.get(id, {})


static func tech_name(id: String) -> String:
	return get_tech(id).get("name", id)


## Что открывает технология (батальоны с таким req).
static func unlocks(id: String) -> String:
	var parts: Array = []
	for bt in Military.BATTALIONS:
		if bt["req"] == id:
			parts.append(String(bt["name"]).to_lower() + " батальон")
	return ", ".join(parts)


## Эффект технологии словами.
static func effect_text(t: Dictionary) -> String:
	var parts: Array = []
	var u := unlocks(t["id"])
	if u != "":
		parts.append("открывает: " + u)
	var bon: Dictionary = t["bonus"]
	for k in bon:
		if k == "synth_oil":
			parts.append("синтетическая нефть +%d" % int(bon[k]))
		elif k == "synth_rubber":
			parts.append("синтетический каучук +%d" % int(bon[k]))
		else:
			parts.append("%s +%d%%" % [BONUS_NAMES.get(k, k), roundi(float(bon[k]) * 100.0)])
	return "; ".join(parts)


## Слоты исследований: великие державы — 3, средние (по числу фабрик) — 3, слабые — 2.
static func slots_for(nat) -> int:
	if nat.major or nat.civ + nat.mil >= SLOTS_INDUSTRY:
		return SLOTS_MAJOR
	return SLOTS_MINOR


## Базовые стартовые технологии по промышленности страны (при загрузке мира).
static func grant_base(nat) -> void:
	for tier in START_BASE:
		if nat.civ + nat.mil >= int(tier[0]):
			for id in tier[1]:
				complete(nat, id)
			return


## Привести список слотов к нужной длине (слоты только прибавляются).
static func fit_slots(nat) -> void:
	nat.research_slots = maxi(nat.research_slots, slots_for(nat))
	while nat.research.size() < nat.research_slots:
		nat.research.append("")


static func can_research(nat, t: Dictionary) -> bool:
	if t.is_empty() or nat.techs.has(t["id"]):
		return false
	return t["req"] == "" or nat.techs.has(t["req"])


static func in_work(nat, id: String) -> bool:
	return nat.research.has(id)


## Доступные сейчас: не изучены, не в работе, требования выполнены.
static func available(nat) -> Array:
	var res: Array = []
	for t in all():
		if can_research(nat, t) and not nat.research.has(t["id"]):
			res.append(t)
	return res


static func year_now(world) -> float:
	return World.START_YEAR + world.day / 365.25


## Множитель срока за опережение года (1 — без штрафа).
static func ahead_mult(world, t: Dictionary) -> float:
	return 1.0 + AHEAD_PENALTY * maxf(0.0, float(t["year"]) - year_now(world))


## Сколько «дней работы» слот даёт за день.
static func speed(world, nat, t: Dictionary) -> float:
	return maxf(MIN_SPEED, 1.0 + nat.b("research")) / ahead_mult(world, t)


## Оценка оставшихся дней (штраф за опережение тает со временем — считаем по шагам).
static func days_left(world, nat, id: String) -> int:
	var t := get_tech(id)
	if t.is_empty():
		return 0
	var left: float = float(t["days"]) - float(nat.research_progress.get(id, 0.0))
	var base := maxf(MIN_SPEED, 1.0 + nat.b("research"))
	var yr := year_now(world)
	var days := 0
	while left > 0.0 and days < 20000:
		var step := 10
		var m := 1.0 + AHEAD_PENALTY * maxf(0.0, float(t["year"]) - yr)
		var per := base / m
		if left <= per * step:
			days += ceili(left / per)
			break
		left -= per * step
		days += step
		yr += step / 365.25
	return days


## Поставить технологию в слот (прежняя работа слота сохраняет накопленное).
static func start(nat, slot: int, id: String) -> bool:
	fit_slots(nat)
	var t := get_tech(id)
	if slot < 0 or slot >= nat.research.size() or not can_research(nat, t) or nat.research.has(id):
		return false
	nat.research[slot] = id
	return true


static func free_slot(nat) -> int:
	for i in nat.research.size():
		if nat.research[i] == "":
			return i
	return -1


## День науки страны. Возвращает изученные сегодня технологии.
static func daily(world, nat) -> Array:
	var done: Array = []
	for i in nat.research.size():
		var id: String = nat.research[i]
		if id == "":
			continue
		var t := get_tech(id)
		if t.is_empty() or nat.techs.has(id):
			nat.research[i] = ""
			continue
		var p: float = float(nat.research_progress.get(id, 0.0)) + speed(world, nat, t)
		if p >= float(t["days"]):
			nat.research[i] = ""
			nat.research_progress.erase(id)
			complete(nat, id)
			done.append(id)
		else:
			nat.research_progress[id] = p
	return done


static func complete(nation, id: String) -> void:
	var t := get_tech(id)
	if t.is_empty() or nation.techs.has(id):
		return
	nation.techs[id] = true
	var bon: Dictionary = t["bonus"]
	# пересчёт дивизий, флота и авиации нужен только от боевых бонусов и открытий
	if bon.is_empty():
		nation.stats_dirty = true
	for k in bon:
		if not ECON_KEYS.has(k):
			nation.stats_dirty = true
	for k in bon:
		if k == "synth_oil":
			nation.res_synth[Economy.R_OIL] += float(bon[k])
		elif k == "synth_rubber":
			nation.res_synth[Economy.R_RUBBER] += float(bon[k])
		else:
			nation.bonus[k] = float(nation.bonus.get(k, 0.0)) + float(bon[k])


## Выбор ИИ для свободного слота: сначала технологии своего года и раньше,
## по важности категории для страны; вперёд времени — не дальше полугода.
static func ai_pick(world, nat) -> String:
	var yr := year_now(world)
	var has_navy: bool = nat.naval_share > 0.0
	var best := ""
	var best_score := 1e9
	for t in available(nat):
		var ahead := float(t["year"]) - yr
		if ahead > 0.5:
			continue
		var prio := 2.0
		match String(t["cat"]):
			"ind":
				prio = 0.0
			"inf":
				prio = 0.5
			"sup":
				prio = 1.0
			"elec":
				prio = 1.5
			"tank":
				# танки и моторизация — тем, у кого есть заводы под них
				if not nat.major and nat.mil < 5:
					continue
				prio = 1.0 if nat.techs.has("armor1") else 2.0
			"air":
				prio = 2.0 if nat.air_share > 0.05 else 4.0
			"navy":
				if not has_navy:
					continue
				prio = 1.0 if nat.naval_share >= 0.2 else 2.5
		if t["id"] == "mot1" and not nat.major and nat.mil < 3:
			continue
		if not has_navy and (t["bonus"].has("escort") or t["bonus"].has("sub_raid")) and t["bonus"].size() == 1:
			continue
		var score := (float(t["year"]) - World.START_YEAR) * 2.0 + prio + maxf(0.0, ahead) * 6.0 \
			+ float((int(t["n"]) * 7 + nat.id * 13) % 5) * 0.2
		if score < best_score:
			best_score = score
			best = t["id"]
	return best
